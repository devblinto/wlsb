{
    "name": "wlsb/access",
    "description": "Users, roles, permissions, and approval-workflow management for the wlsb Bedrock site.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "php-stubs/wordpress-stubs": "^6.7",
        "phpcompatibility/php-compatibility": "^9.3",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Wlsb\\Access\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.3"
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "sniff": "phpcs",
        "sniff:fix": "phpcbf",
        "test": "pest"
    },
    "scripts-descriptions": {
        "lint": "Check PER/PSR-12 formatting with Laravel Pint.",
        "sniff": "Run WPCS security sniffs (escaping, nonces, prepared SQL).",
        "test": "Run the Pest unit suite."
    }
}
