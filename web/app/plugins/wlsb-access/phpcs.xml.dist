<?xml version="1.0"?>
<ruleset name="wlsb-access-security">
    <description>Security-focused WPCS sniffs for the wlsb-access plugin. Formatting is handled separately by Laravel Pint (PER/PSR-12); this ruleset intentionally covers only security-critical concerns.</description>

    <file>src</file>
    <file>templates</file>
    <file>wlsb-access.php</file>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.3-"/>
    <config name="minimum_wp_version" value="6.7"/>

    <!-- Output escaping, nonce/CSRF checks, sanitisation, unsafe superglobals. -->
    <rule ref="WordPress.Security"/>
    <!-- Prepared SQL and placeholder correctness for all $wpdb usage. -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <!-- Flag hardcoded/ambiguous capability strings. -->
    <rule ref="WordPress.WP.Capabilities"/>
    <!-- Fail on syntax not supported by the PHP 8.3 platform floor. -->
    <rule ref="PHPCompatibility"/>

    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
