<?xml version="1.0"?>
<ruleset name="wlsb-access-security">
    <description>Security-focused WPCS sniffs for the wlsb-access plugin. Formatting is handled separately by Laravel Pint (PER/PSR-12); this ruleset intentionally covers only security-critical concerns.</description>

    <file>src</file>
    <file>templates</file>
    <file>wlsb-access.php</file>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="parallel" value="8"/>

    <config name="testVersion" value="8.3-"/>
    <config name="minimum_wp_version" value="6.7"/>

    <!-- Output escaping, nonce/CSRF checks, sanitisation, unsafe superglobals. -->
    <rule ref="WordPress.Security"/>

    <!--
        Exception messages in the pure Domain/Application layers are WordPress-free
        by design and are escaped at their real output site (admin templates via
        esc_html()). Escaping them at the throw site would couple those layers to
        WordPress and double-escape. This sniff stays fully active for the
        Delivery layer and templates, where output actually happens.
    -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>*/src/Application/*</exclude-pattern>
        <exclude-pattern>*/src/Domain/*</exclude-pattern>
        <exclude-pattern>*/src/Infrastructure/*</exclude-pattern>
    </rule>
    <!-- Prepared SQL and placeholder correctness for all $wpdb usage. -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
    <!-- Flag hardcoded/ambiguous capability strings. -->
    <rule ref="WordPress.WP.Capabilities"/>
    <!-- Fail on syntax not supported by the PHP 8.3 platform floor. -->
    <rule ref="PHPCompatibility">
        <!--
            PHPCompatibility 9.3 predates PHP 8.1 enums and misreads $this inside
            an enum method as being outside object context. This is valid on our
            PHP 8.3 floor, so the false positive is excluded.
        -->
        <exclude name="PHPCompatibility.Variables.ForbiddenThisUseContexts.OutsideObjectContext"/>
    </rule>

    <exclude-pattern>*/tests/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
