---
# ansible-lint configuration.
profile: production

exclude_paths:
  - collections/
  - .cache/

# Inventory host IPs are documentation placeholders, not real secrets.
skip_list:
  - yaml[line-length]   # some templated command lines are intentionally long

# Vault files are encrypted; don't try to parse them as plain vars.
kinds:
  - vars: "**/group_vars/**/vault.yml"
