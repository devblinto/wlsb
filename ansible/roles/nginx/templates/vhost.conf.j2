{#
  Bedrock virtual host. Two-phase bootstrap:
    * No cert yet  → HTTP serves the site (and the ACME challenge) so certbot can
                     validate the domain.
    * Cert present → HTTP redirects to HTTPS; HTTPS serves the site.
  The shared body is defined once as a macro to avoid drift between the blocks.
#}
{%- macro site_body() -%}
    root {{ deploy_path }}/current/web;
    index index.php;

    # Bedrock keeps .env, composer.json, config/ etc. OUTSIDE this docroot, so
    # they are not web-reachable by design.

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    # Long-cache static assets.
    location ~* \.(?:css|js|jpg|jpeg|gif|png|svg|webp|ico|woff2?|ttf|eot|mp4|webm|ogg|ogv|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
        log_not_found off;
        try_files $uri =404;
    }

    # PHP via the site's dedicated FPM pool.
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTPS $https_flag;
        fastcgi_pass unix:/run/php/{{ site_name }}-fpm.sock;
        fastcgi_index index.php;
        fastcgi_read_timeout {{ nginx_fastcgi_read_timeout }};
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    # Protected PHP-FPM status/health endpoints (localhost only).
    location ~ ^/(fpm-status|fpm-ping)$ {
        allow 127.0.0.1;
        deny all;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $fastcgi_script_name;
        fastcgi_pass unix:/run/php/{{ site_name }}-fpm.sock;
    }

    # Deny dotfiles (except ACME) and common noisy/abused endpoints.
    location ~ /\.(?!well-known).* { deny all; }
    location = /xmlrpc.php { deny all; access_log off; log_not_found off; }
    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt { access_log off; log_not_found off; allow all; }
{%- endmacro -%}

# ── HTTP ────────────────────────────────────────────────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name {{ site_domain }}{% for a in site_aliases %} {{ a }}{% endfor %};

    # Always answer ACME HTTP-01 challenges from the shared webroot.
    location ^~ /.well-known/acme-challenge/ {
        root {{ letsencrypt_webroot }};
        default_type "text/plain";
        allow all;
    }

{% if has_tls_cert %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    set $https_flag off;
{{ site_body() }}
{% endif %}
}

{% if has_tls_cert %}
# ── HTTPS ───────────────────────────────────────────────────────────────────────
server {
    # `listen … ssl http2` works on nginx 1.24 (Ubuntu 24.04) and newer; the
    # separate `http2 on;` directive only exists from 1.25.1.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ site_domain }}{% for a in site_aliases %} {{ a }}{% endfor %};

    ssl_certificate     /etc/letsencrypt/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site_domain }}/privkey.pem;
    include snippets/ssl-params.conf;
    include snippets/security-headers.conf;
    add_header Strict-Transport-Security "max-age={{ nginx_hsts_max_age }}; includeSubDomains" always;

    set $https_flag on;
{{ site_body() }}
}
{% endif %}
