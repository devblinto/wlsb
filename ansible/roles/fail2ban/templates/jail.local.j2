# Managed by Ansible.
[DEFAULT]
bantime  = {{ fail2ban_bantime }}
findtime = {{ fail2ban_findtime }}
maxretry = {{ fail2ban_maxretry }}
ignoreip = {{ fail2ban_ignoreips | join(' ') }}
# Ubuntu 24.04 reads journald rather than /var/log/auth.log by default.
backend  = systemd

[sshd]
enabled  = true
port     = {{ fail2ban_ssh_port }}
