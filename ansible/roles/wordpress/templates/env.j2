# Managed by Ansible — shared runtime environment for {{ site_name }} ({{ wp_env }}).
# Bedrock loads this via config/application.php. Do NOT edit by hand on the server;
# change the vault / group_vars and re-run provisioning instead.

DB_NAME='{{ db_name }}'
DB_USER='{{ db_user }}'
DB_PASSWORD='{{ db_password }}'
DB_HOST='{{ db_host }}'
DB_PREFIX='{{ db_prefix }}'

WP_ENV='{{ wp_env }}'
WP_HOME='{{ wp_home }}'
WP_SITEURL='{{ wp_siteurl }}'

# Run WordPress cron from the system crontab instead of on page loads.
DISABLE_WP_CRON='true'

# Authentication unique keys and salts.
AUTH_KEY='{{ wp_salts.AUTH_KEY }}'
SECURE_AUTH_KEY='{{ wp_salts.SECURE_AUTH_KEY }}'
LOGGED_IN_KEY='{{ wp_salts.LOGGED_IN_KEY }}'
NONCE_KEY='{{ wp_salts.NONCE_KEY }}'
AUTH_SALT='{{ wp_salts.AUTH_SALT }}'
SECURE_AUTH_SALT='{{ wp_salts.SECURE_AUTH_SALT }}'
LOGGED_IN_SALT='{{ wp_salts.LOGGED_IN_SALT }}'
NONCE_SALT='{{ wp_salts.NONCE_SALT }}'
