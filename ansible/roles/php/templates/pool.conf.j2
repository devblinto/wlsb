; Managed by Ansible — dedicated FPM pool for {{ site_name }}.
[{{ site_name }}]
user = {{ deploy_user }}
group = {{ deploy_group }}

; Unix socket owned by the deploy user, readable by Nginx (www-data).
listen = /run/php/{{ site_name }}-fpm.sock
listen.owner = {{ deploy_user }}
listen.group = www-data
listen.mode = 0660

pm = {{ php_fpm_pm }}
pm.max_children = {{ php_fpm_pm_max_children }}
pm.start_servers = {{ php_fpm_pm_start_servers }}
pm.min_spare_servers = {{ php_fpm_pm_min_spare_servers }}
pm.max_spare_servers = {{ php_fpm_pm_max_spare_servers }}
pm.max_requests = {{ php_fpm_pm_max_requests }}

; Expose a protected status endpoint for monitoring (Nginx restricts access).
pm.status_path = /fpm-status
ping.path = /fpm-ping

; Send worker stderr to the FPM/journald log instead of silently dropping it.
catch_workers_output = yes
decorate_workers_output = no

; Per-site slow log helps track down long-running requests.
slowlog = /var/log/php{{ php_version }}-fpm-{{ site_name }}-slow.log
request_slowlog_timeout = 10s

; Harden: only allow executing .php files.
security.limit_extensions = .php
