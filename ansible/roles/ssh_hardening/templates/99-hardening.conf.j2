# Managed by Ansible — SSH hardening drop-in (overrides /etc/ssh/sshd_config).
PermitRootLogin {{ 'yes' if ssh_permit_root_login else 'no' }}
PasswordAuthentication {{ 'yes' if ssh_password_authentication else 'no' }}
KbdInteractiveAuthentication {{ 'yes' if ssh_password_authentication else 'no' }}
PubkeyAuthentication yes
PermitEmptyPasswords no
AuthenticationMethods publickey{{ ' password' if ssh_password_authentication else '' }}

MaxAuthTries {{ ssh_max_auth_tries }}
LoginGraceTime {{ ssh_login_grace_time }}
ClientAliveInterval {{ ssh_client_alive_interval }}
ClientAliveCountMax {{ ssh_client_alive_count_max }}

X11Forwarding {{ 'yes' if ssh_x11_forwarding else 'no' }}
AllowAgentForwarding {{ 'yes' if ssh_allow_agent_forwarding else 'no' }}
AllowTcpForwarding no
PermitTunnel no

UsePAM yes
PrintMotd no
