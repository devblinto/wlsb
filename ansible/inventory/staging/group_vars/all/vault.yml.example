---
# ═══════════════════════════════════════════════════════════════════════════════
# SECRETS TEMPLATE — copy to `vault.yml`, fill in, then ENCRYPT:
#
#     cp vault.yml.example vault.yml
#     # edit vault.yml …
#     ansible-vault encrypt vault.yml
#
# Ansible auto-loads group_vars/all/vault.yml. Never commit the decrypted file.
# Edit later with:  ansible-vault edit vault.yml
# ═══════════════════════════════════════════════════════════════════════════════

# MySQL root password (used only locally on the server, over the unix socket).
#   generate:  openssl rand -base64 24
vault_mysql_root_password: "CHANGE_ME_root"

# Application database user's password.
#   generate:  openssl rand -base64 24
vault_db_password: "CHANGE_ME_db"

# WordPress unique keys & salts. Generate a fresh set:
#   curl https://roots.io/salts.html    (copy the KEY/SALT values)
# or produce raw 64-char strings with:  openssl rand -base64 48
vault_wp_salts:
  AUTH_KEY: "CHANGE_ME"
  SECURE_AUTH_KEY: "CHANGE_ME"
  LOGGED_IN_KEY: "CHANGE_ME"
  NONCE_KEY: "CHANGE_ME"
  AUTH_SALT: "CHANGE_ME"
  SECURE_AUTH_SALT: "CHANGE_ME"
  LOGGED_IN_SALT: "CHANGE_ME"
  NONCE_SALT: "CHANGE_ME"

# Admin SSH public keys granted sudo access to the server. At least one is
# REQUIRED — SSH password auth is disabled during hardening.
vault_admin_ssh_keys:
  - "ssh-ed25519 AAAA... you@laptop"

# Private SSH deploy key the server uses to clone a PRIVATE Git repo.
# Only needed when `deploy_use_deploy_key: true`. Paste the full private key
# (add its PUBLIC half as a read-only deploy key in GitHub/GitLab).
# Leave as an empty string for public (https) repositories.
vault_deploy_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  ...paste the deploy private key here...
  -----END OPENSSH PRIVATE KEY-----
