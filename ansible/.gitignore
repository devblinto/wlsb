# Ansible Vault password file — NEVER commit this.
.vault_pass
*.vault_pass

# Decrypted vault files. Commit only the *.example templates and the encrypted
# vault.yml (which is ciphertext and safe to commit once `ansible-vault encrypt`ed).
# If you prefer NOT to commit even the encrypted vault, uncomment the next line:
# **/group_vars/all/vault.yml

# Installed Galaxy collections (pulled via requirements.yml).
collections/

# Ansible runtime artifacts.
*.retry
fact_cache/
.ansible/
